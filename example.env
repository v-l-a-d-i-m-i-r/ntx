INSTALL_DIR=$HOME/.bin

# Optional overrides for ntx-server/ntx-dbus-forwarder; both have built-in defaults
# (/tmp/ntx.sock and $HOME/.local/share/ntx/ntx.db) used when unset. .env
# values are not shell-expanded, so paths here must be literal, not $HOME.
# NTX_SOCKET_PATH=/tmp/ntx.sock
# NTX_DB_PATH=/home/youruser/.local/share/ntx/ntx.db

# Optional log level for ntx-server. One of: debug, info, warn, error.
# Defaults to info when unset or unrecognized.
NTX_SERVER_LOG_LEVEL=info

# Optional log level for ntx-dbus-forwarder. One of: debug, info, warn, error.
# Defaults to info when unset or unrecognized.
NTX_DBUS_FORWARDER_LOG_LEVEL=info
