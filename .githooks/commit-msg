COMMIT_MSG_FILE="$1"

sed -i.bak '/^Co-authored-by:.*[Cc][Oo][Pp][Ii][Ll][Oo][Tt]/d' "$COMMIT_MSG_FILE"
sed -i.bak '/^[Cc]o-[Aa]uthored-[Bb]y:.*[Vv][Ii][Bb][Ee]/d' "$COMMIT_MSG_FILE"
